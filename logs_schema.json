              "total_gb": 50,
              "free_gb": 12.3,
              "used_pct": 75.4
            }
          },
          "load_average": [2.34, 1.89, 1.56],
          "network_io": {
            "bytes_sent": 1234567890,
            "bytes_recv": 2345678901
