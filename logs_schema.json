          "oldest_job_age_seconds": 3600,
          "throughput_jobs_per_hour": 45,
          "error_rate_percent": 4.1
        }
      }
    }
  },
  
  "best_practices": {
    "log_levels": {
      "DEBUG": "Detailed diagnostic information for developers",
      "INFO": "Normal operational events and milestones",
      "WARNING": "Potential issues that don't prevent operation",
      "ERROR": "Errors that prevent a specific operation but allow system to continue",
      "CRITICAL": "Severe errors that require immediate attention"
    },
    
    "context_enrichment": {
      "required_context": "Always include job_context for conversion-related logs",
      "trace_id": "Use consistent trace_id for end-to-end request tracing",
      "correlation_id": "Include correlation_id for distributed tracing across services"
    },
    
    "performance_logging": {
      "timing_granularity": "Log stage timings at millisecond precision",
      "resource_metrics": "Include memory, CPU, disk I/O metrics for performance analysis",
      "throughput_calculation": "Calculate and log throughput metrics for capacity planning"
    },
    
    "error_logging": {
      "structured_errors": "Always include error_type, error_code, error_message",
      "stack_traces": "Include full stack traces for ERROR and CRITICAL levels",
      "recovery_actions": "Document recovery actions taken after errors"
    }
  }
}