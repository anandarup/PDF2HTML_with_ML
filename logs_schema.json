      "core_metadata": {
        "timestamp": "2026-09-28T12:45:00.000Z",
        "level": "DEBUG",
        "logger": "pdf2webview",
        "pid": 123459
      },
      "infrastructure_metrics": {
        "worker_metrics": {
          "worker_id": "worker-123459",
          "node_id": "node-2",
          "uptime_seconds": 43200,
