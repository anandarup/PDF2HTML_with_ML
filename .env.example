# =============================================================================
# PDF2HTML — Environment Configuration TEMPLATE
# =============================================================================
# Copy this file to `.env` and fill in real values. NEVER commit a real `.env`
# (it is gitignored). This template contains PLACEHOLDERS ONLY — no secrets.
#
# NOTE: The current application hardcodes several of these values (buckets,
# region) as constants and authenticates to OCI via Instance Principals, so it
# does not read a .env today. This file documents the settings that should be
# externalized and the values the parent/CMS side expects.
# =============================================================================

# --- Application ---------------------------------------------------------
FLASK_ENV=production
# Port the Gunicorn/Flask app binds to (behind Nginx)
APP_PORT=8501
# Max upload size in MB (matches Nginx client_max_body_size)
MAX_UPLOAD_SIZE_MB=1200

# --- OCI Object Storage --------------------------------------------------
# Region for the object storage endpoint
OCI_REGION=ap-hyderabad-1
# Tenancy namespace (from `oci os ns get`)
OCI_NAMESPACE=<your-tenancy-namespace>
# Buckets (rendered HTML, source media, streaming video)
BUCKET_HTML=poc-interactivetxtbk1
BUCKET_MEDIA_SRC=poc-interactivetxt-media-src-bucket
BUCKET_MEDIA_DST=poc-interactivetxt-media-dst-bucket
# Auth: production uses OCI Instance/Workload Principals (no keys on disk).
# If using an API key instead, point to the config file (do NOT inline keys):
# OCI_CONFIG_FILE=~/.oci/config
# OCI_CONFIG_PROFILE=DEFAULT

# --- Docling tool / parent integration -----------------------------------
# Public base URL of this conversion tool (used by the parent CMS)
DOCLING_TOOL_URL=https://poc-interactivetxtbk.diksha.gov.in

# --- Strapi (DIKSHA CMS) export ------------------------------------------
STRAPI_BASE_URL=https://strapi.example.gov.in
# JWT token for the Strapi content-manager API — set in your local .env only
STRAPI_API_TOKEN=<your-strapi-jwt>

# --- WordPress export (optional) -----------------------------------------
WORDPRESS_BASE_URL=https://wordpress.example.com
WORDPRESS_USERNAME=<wp-username>
WORDPRESS_APP_PASSWORD=<wp-application-password>

# --- OCR engine ----------------------------------------------------------
# Which OCR engine to use for PDF text extraction.
#   rapidocr : (default) in-process Docling + RapidOCR. No data leaves the VM.
#   surya    : hosted Datalab/Surya API. Page content is sent to Datalab for
#              processing (results deleted there ~1h after completion).
OCR_ENGINE=rapidocr
# Datalab API key — required only when OCR_ENGINE=surya. SECRET: set in your
# local .env only, never commit. Paste the real value after the '='.
DATALAB_API_KEY=<your-datalab-api-key>
# Datalab API base URL (leave as default unless self-hosting the container).
DATALAB_API_BASE_URL=https://www.datalab.to
# Parsing quality/latency tradeoff: fast | balanced | accurate
DATALAB_MODE=balanced
# Automatic image captions (picture descriptions). The OCR backend writes them
# in English whatever the document's language, so:
#   auto   : (default) caption English documents only; for other languages the
#            caption is left empty and the editor writes it in the document view
#   always : caption every document, whatever its language
#   never  : never request captions; editors write all of them
DATALAB_IMAGE_CAPTIONS=auto
# Data residency region for Datalab processing: us | eu
DATALAB_PROCESSING_LOCATION=us
# End-to-end timeout (seconds) for a single Datalab conversion round-trip.
DATALAB_TIMEOUT_SECONDS=600
# Seconds between status polls while a Datalab job is processing.
DATALAB_POLL_INTERVAL_SECONDS=2

# --- External services ---------------------------------------------------
# Wikipedia REST API base (used for diagram label descriptions)
WIKIPEDIA_API_BASE=https://en.wikipedia.org/api/rest_v1
# --- Delete webhook (DELETE /api/documents/<job_dir>) ---------------------
# Shared secret the caller must send in the X-Delete-Token header. This is
# irreversible and destroys published content, so it gets a check at the app
# layer too, not just the API Gateway's "service" scope. SECRET: set in your
# local .env only, never commit. Leave unset to skip the check (matches this
# app's current all-routes-unauthenticated default) -- do that only if the
# gateway/network layer is trusted to be the sole guard.
DELETE_API_TOKEN=<a-long-random-shared-secret>
